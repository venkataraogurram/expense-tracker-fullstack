# Elastic Beanstalk configuration bundled with every deploy (deploy/build-bundle.sh
# zips this folder next to the jar). Secrets (DB_PASSWORD etc.) are NOT here; they
# are set as environment properties on the environment itself (README > Deploy).
option_settings:
  # ALB target group health check hits Spring Boot Actuator.
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /actuator/health
    HealthCheckInterval: '15'
    HealthyThresholdCount: '2'
    UnhealthyThresholdCount: '5'
    MatcherHTTPCode: '200'
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /actuator/health
  aws:elasticbeanstalk:application:environment:
    # nginx on the Corretto platform proxies to 5000; with a Procfile the
    # platform does not set PORT for us, so set it here.
    PORT: '5000'
    DB_USE_SSL: 'true'
